{
  "name": "@schwanki/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:staging": "node scripts/build-for-deploy.mjs staging",
    "build:production": "node scripts/build-for-deploy.mjs production",
    "deploy:staging": "pnpm build:staging && wrangler deploy --env staging",
    "deploy:production": "pnpm build:production && wrangler deploy --env production",
    "test:deployment": "node --test scripts/deployment-config.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@schwanki/core": "workspace:^",
    "@schwanki/mnemonic": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "wrangler": "4.148.0"
  }
}
