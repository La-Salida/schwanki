{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level is what Workers Builds uses on PR branches (`wrangler versions upload`, no --env).
  // It must match the connected Worker, schwanki-staging, or every PR build fails. Releases always pass --env.
  "name": "schwanki-staging",
  "account_id": "3e3bb97e0cbe38430ffb66b934d42bb1",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "name": "schwanki-staging",
      "workers_dev": true,
      "routes": [
        { "pattern": "schwankiapp.com", "custom_domain": true },
        { "pattern": "www.schwankiapp.com", "custom_domain": true }
      ],
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    },
    "production": {
      "name": "schwanki",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
