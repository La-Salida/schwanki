{
  "name": "@schwanki/ios",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "./scripts/start-dev-safe.sh",
    "start:lan": "./scripts/start-dev-safe.sh",
    "start:tunnel": "npx expo start --dev-client --host tunnel --clear",
    "build:sim": "npx eas build --profile development --platform ios",
    "build:sim:ios": "npx eas build --profile development --platform ios",
    "build:dev": "npx eas build --profile development-device --platform ios",
    "build:ios:dev": "npx eas build --profile development-device --platform ios",
    "build:ios:prod": "npx eas build --profile production --platform ios --auto-submit",
    "build:ios:prod:only": "npx eas build --profile production --platform ios",
    "retry:ios:prod": "npx eas build --profile production --platform ios --auto-submit",
    "submit": "npx eas submit --platform ios",
    "submit:ios": "npx eas submit --platform ios",
    "clear:metro": "rm -rf node_modules/.cache && rm -rf .expo",
    "dev": "expo start",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "export": "expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "node qa/smoke.mjs",
    "test:simulator": "node qa/native-smoke.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@schwanki/anki": "workspace:*",
    "@schwanki/core": "workspace:*",
    "@schwanki/mnemonic": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-auth-session": "~58.0.17",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-superwall": "1.7.0",
    "expo-web-browser": "~58.0.7",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-purchases": "^10.16.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  }
}
