{
  "expo": {
    "name": "Schwanki",
    "slug": "schwanki-ios",
    "scheme": "schwanki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.lasalida.schwanki",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Choose a class photo or screenshot to turn into vocabulary cards."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "name": "Schwanki iOS preview",
      "favicon": "./assets/icon.png"
    },
    "owner": "lasalida",
    "extra": {
      "eas": {
        "projectId": "f1b76061-2f78-436b-b0aa-ba93691bdc24"
      }
    }
  }
}
