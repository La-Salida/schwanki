VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=see `supabase status`
# Comma-separated unpacked extension IDs; set in apps/web/.env for local handoff.
VITE_EXTENSION_IDS=
ANTHROPIC_API_KEY=sk-ant-...
PARSE_MODEL=claude-haiku-4-5
# Google OAuth (supabase/.env — loaded by CLI for config.toml env() substitution)
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Our-key credit path for generate-mnemonic (supabase/functions/.env)
OPENAI_API_KEY=sk-...
FAL_KEY=...
TOGETHER_API_KEY=...
HIGGSFIELD_API_KEY=...
OPENROUTER_API_KEY=sk-or-...
ELEVENLABS_API_KEY=...
FISH_API_KEY=...
